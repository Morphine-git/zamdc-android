<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vampire_black"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/vampire_silver"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvHomeDirLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Home Directory:"
        android:textSize="16sp"
        android:textColor="@color/vampire_red"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvHomeDirValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="(not set)"
        android:textSize="14sp"
        android:textColor="@color/vampire_silver"
        android:padding="8dp"
        android:background="#22000000"
        app:layout_constraintTop_toBottomOf="@id/tvHomeDirLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvContentDirsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Content Locations:"
        android:textSize="16sp"
        android:textColor="@color/vampire_red"
        app:layout_constraintTop_toBottomOf="@id/tvHomeDirValue"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvContentDirsValue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="(none)"
        android:textSize="14sp"
        android:textColor="@color/vampire_silver"
        android:padding="8dp"
        android:background="#22000000"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvContentDirsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnRefreshSettings"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnRefreshSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Refresh"
        android:textColor="@color/vampire_silver"
        android:backgroundTint="@color/vampire_red"
        app:layout_constraintBottom_toTopOf="@id/btnResetSettings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnResetSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Reset"
        android:textColor="@color/vampire_silver"
        android:backgroundTint="@color/vampire_black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

