<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Transparent splash theme -->
    <style name="Theme.Transparent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Permission dialog look -->
    <style name="PermDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0B0B0</item>
        <item name="android:colorAccent">#D32F2F</item>
        <item name="colorAccent">#D32F2F</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PermButtonPositive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/PermButtonNegative</item>
    </style>

    <style name="PermButtonPositive" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">#D32F2F</item>
    </style>

    <style name="PermButtonNegative" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Custom gothic text -->
    <style name="VHeaderText">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/vampire_silver</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/gothic_font</item>
    </style>

    <style name="VTextLight">
        <item name="android:textColor">@color/vampire_silver</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/gothic_font</item>
    </style>

    <style name="VampireButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/vampire_red</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">@font/gothic_font</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/vampire_red_dark</item>
    </style>

    <!-- Main dark gothic theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryDark">#121212</item>
        <item name="colorSecondary">#8B0000</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">#000000</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

</resources>

