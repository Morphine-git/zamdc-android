<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vampire_silver">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <layer-list>
            <!-- base -->
            <item android:drawable="@drawable/vampire_button_bg" />
            <!-- subtle outer glow that appears when pressed (state overlay via ripple) -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="@android:color/transparent" />
                    <padding android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp" />
                    <stroke android:width="0dp" android:color="@android:color/transparent" />
                    <size android:height="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
